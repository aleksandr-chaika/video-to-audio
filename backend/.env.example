APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

REDIS_URL=redis://redis:6379/0

JOB_TTL_SEC=3600
JOB_TIMEOUT_SEC=300
TMP_DIR=/tmp/mp3craft

RATE_LIMIT_CREATE=10/minute
RATE_LIMIT_STATUS=60/minute

ALLOWED_HOSTS_RAW=youtube.com,youtu.be,m.youtube.com,www.youtube.com,music.youtube.com
CORS_ORIGINS_RAW=*

# Optional yt-dlp tuning
YT_COOKIES_PATH=
YT_PROXY=
